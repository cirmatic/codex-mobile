# Copy to .runtime/service.env. Values are read by Node's --env-file.
PORT=3030
HOST=127.0.0.1
# Replace /home/your-user with your own absolute home path.
# Absolute directories, separated by colon on Linux; only list/create/session selection is constrained here.
PROJECT_ROOTS=/home/your-user
# Optional: set after tailscale serve supplies your address.
# PUBLIC_ORIGIN=https://your-laptop.your-tailnet.ts.net
# Optional: path to the Codex executable, otherwise resolved from PATH.
# CODEX_BIN=/home/your-user/.local/bin/codex
# Optional: isolated Codex home; normally reuse ~/.codex.
# CODEX_MOBILE_HOME=/home/your-user/apps/codex-mobile/.runtime/codex-home

# Shared desktop daemon; stopping the bridge only closes its proxy.
CODEX_CONNECTION=shared
